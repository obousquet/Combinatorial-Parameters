{
  "version": 1,
  "purpose": "Declares the single authoritative representation for information shared by the database website and LaTeX survey.",
  "owners": {
    "parameter_catalog": {
      "authority": "database",
      "source": "data/parameters/*.json",
      "latex_output": "includes/generated/def_table.tex",
      "generator": "sync/generate_latex_catalog.py --section parameter-table"
    },
    "parameter_definitions": {
      "authority": "database",
      "source": "data/latex/parameter_definitions.tex",
      "latex_output": "includes/generated/parameter_definitions.tex",
      "generator": "sync/generate_latex_catalog.py --section parameter-definitions"
    },
    "class_catalog": {
      "authority": "database",
      "source": "data/classes/*.json",
      "latex_output": "includes/generated/class_definitions.tex",
      "generator": "sync/generate_latex_catalog.py --section class-definitions"
    },
    "parameter_relationships": {
      "authority": "database",
      "source": "data/relationships/*.json",
      "latex_output": null,
      "status": "The website graph is derived from these facts. The survey's explanatory hierarchy remains editorial."
    },
    "parameter_values": {
      "authority": "database",
      "source": "data/values/*.json",
      "latex_output": "includes/generated/val_table.tex",
      "generator": "sync/generate_latex_catalog.py --section value-table"
    },
    "bibliography": {
      "authority": "database",
      "source": "data/latex/references.bib",
      "latex_output": "includes/generated/references.bib",
      "generator": "sync/generate_latex_catalog.py --section bibliography"
    },
    "survey_narrative_and_proofs": {
      "authority": "latex",
      "source": "main.tex and included prose files",
      "database_output": null
    }
  }
}
